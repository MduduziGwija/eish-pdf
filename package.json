{
  "name": "eish-pdf",
  "version": "0.1.0",
  "description": "Eish PDF – free PDF tools that run entirely in your browser.",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
